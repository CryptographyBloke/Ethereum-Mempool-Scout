# Primary collector: ingests blocks, fetches and decodes pending transactions, quotes swaps.
SCOUT_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SCOUT_VANTAGE=alchemy

# Optional second vantage point (docker compose --profile multi up -d)
SCOUT_WSS_URL_B=wss://YOUR_SECOND_PROVIDER
SCOUT_VANTAGE_B=provider-b
